# Copiar a .env (no se versiona): `cp .env.example .env` (Windows: `copy .env.example .env`).
# docker compose lee este archivo solo. Lo único obligatorio es DJANGO_SECRET_KEY.

# --- App web (obligatorio) ---

# Clave secreta de Django: una cadena larga al azar, distinta en cada instalación.
# Generarla con:
#   docker run --rm python:3.13-slim-trixie python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Hosts desde los que se abre la app, separados por coma. Al instalar en un
# servidor, agregar su nombre o IP (ej. localhost,127.0.0.1,shelfvision.miempresa.cl).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 0 para probar sin certificado (http://localhost:8000). 1 cuando la app va
# detrás de HTTPS (producción): activa las cookies seguras.
DJANGO_HTTPS=0

# --- Solo para reentrenar el modelo (opcional) ---

# API key personal de Roboflow: la usa scripts/download_datasets.py para los
# 2 datasets de Roboflow (ver docs/datasets.md). Sin ella, esos se omiten.
ROBOFLOW_API_KEY=
